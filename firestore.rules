rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Student account records
    match /classes/{classId}/students/{studentKey} {
      allow read, write: if true;
    }

    // Student travel project documents
    match /travel_projects/{studentKey} {
      allow read, write: if true;
    }

    // System configurations (class shared password, teacher password hash)
    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}
